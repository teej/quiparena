{
  "name": "@quiparena/jackbox",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "quiparena-jackbox": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lookup": "node --import tsx ./src/cli.ts lookup",
    "play": "node --import tsx ./src/cli.ts play",
    "reconnect": "node --import tsx ./src/cli.ts reconnect"
  },
  "dependencies": {
    "@quiparena/core": "workspace:*",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "vitest": "4.1.11"
  }
}
